# OS & Editor Files
.DS_Store
Thumbs.db
# Anchored to the repository root. Unanchored, `.vscode/` matches a directory of that name at any
# depth, which swallowed client/.vscode - four files that are committed on purpose, since they are
# how the extension is launched and debugged. A tracked file an ignore rule also matches stays
# tracked and silently stops being reported, so the rule read as if it were doing nothing.
/.vscode/
opencode.json

# Agent tooling. Local configuration for the assistants used on this project, not part of it:
# .mcp.json names absolute paths on one machine, and .claude/ carries per-machine settings and
# slash commands. The project's own guide for an agent is .agents/AGENTS.md, which is tracked.
.claude/
.claudeignore
.mcp.json
CLAUDE.md

# Temporary Logs & Output Files
*.log
doctest_failures*.txt
temp_*.txt
# Scoped rather than a blanket `*.txt`: that ignored every text file in the repository and was
# held back only by a growing list of exceptions, so the next LICENSE.txt or requirements.txt
# would have been dropped silently.
/test_output.txt
/test_tmp.txt
**/doctest_output*.txt

# Scratch Scripts & Temporary Tests
audit_temp_*.as
scratch_*.as
temp*.as
test*.as
test_disc*.as

# Build & Compiled Binaries
#
# client/bin holds the compiled server the extension ships. It was tracked - two 8 MB executables
# rewritten by every build, so every server change showed up as an unreviewable binary diff. CI
# already rebuilds all six platform targets and stages them into exactly this layout before
# packaging the .vsix, so nothing about the released extension depends on them being committed.
# Running from a source checkout still works: getServerPath() falls back to server/build/.
client/bin/
build/
server/build/
server/.cache/
client/node_modules/
client/out/
client/.vscode/tasks.log
client/.vscode-test/
angelscript/
.agents/*
!.agents/AGENTS.md

# CTest scratch output, written into whatever directory ctest was invoked from.
Testing/

# Written into the working directory by opt-in corpus tests that copy a stub next to themselves.
/server/as.predefined
/server/tests/as.predefined

# Generated by the graphify tool; a cache, not a source.
graphify-out/
