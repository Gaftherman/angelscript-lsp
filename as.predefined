/// Addon: ASException
/// Exception object storing callstack, line number, message, and metadata.
class Exception{
	/// Exception error message string.
	string message;
	/// Function declaration where exception occurred.
	string func;
	/// Script section or file name where exception occurred.
	string sect;
	/// Call stack trace at the moment exception occurred.
	string stack;
	/// Script line number where exception occurred.
	int line;
	/// Additional contextual data dictionary attached to exception.
	dictionary data;
}
class optional<T>{
	/// Returns true if the optional contains a value, false otherwise.
	bool has_value() const;
	/// Clears the contained value and resets the optional to an empty state.
	void clear();
	/// Returns a reference to the contained value. Throws a script exception if empty.
	const T& value() const;
	/// Sets the value contained in the optional.
	void set(const T&in value);
	/// Assigns a new value to the optional container.
	optional<T>& opAssign(const T&in value);
}
/// Addon: ASJSON
/// JSON value container supporting null, boolean, number, string, array, and object types.
class JSON{
	/// Returns a string representation of the JSON object.
	string to_string() const;
	/// Returns true if the JSON value is null.
	bool is_null() const;
	/// Returns true if the JSON value is a boolean.
	bool is_boolean() const;
	/// Returns true if the JSON value is a number.
	bool is_number() const;
	/// Returns true if the JSON value is an integer number.
	bool is_number_integer() const;
	/// Returns true if the JSON value is an unsigned integer number.
	bool is_number_unsigned() const;
	/// Returns true if the JSON value is a floating point number.
	bool is_number_float() const;
	/// Returns true if the JSON value is an object.
	bool is_object() const;
	/// Returns true if the JSON value is an array.
	bool is_array() const;
	/// Returns true if the JSON value is a string.
	bool is_string() const;
	/// Returns true if the JSON value is a primitive type (null, boolean, number, or string).
	bool is_primitive() const;
	/// Returns true if the JSON value is structured (object or array).
	bool is_structured() const;
	/// When true, operations raise script exceptions on error; when false, operations fail silently.
	bool strict;
}
uint scan(const string&in str, ?&out...);
string format(const string&in fmt, const ?&in...);
string formatInt(int64 val, const string&in options = "", uint width = 0);
string formatUInt(uint64 val, const string&in options = "", uint width = 0);
string formatFloat(double val, const string&in options = "", uint width = 0, uint precision = 0);
int64 parseInt(const string&in, uint base = 10, uint&out byteCount = 0);
uint64 parseUInt(const string&in, uint base = 10, uint&out byteCount = 0);
double parseFloat(const string&in, uint&out byteCount = 0);
string join(const string[]&in, const string&in);
/// Prints a string to the console output.
void print(const string&in);
/// Prints a string to the console output followed by a newline.
void println(const string&in);
float fpFromIEEE(uint);
uint fpToIEEE(float);
double fpFromIEEE(uint64);
uint64 fpToIEEE(double);
bool closeTo(float, float, float = 0.00001f);
bool closeTo(double, double, double = 0.0000000001);
