.vscode/**
.vscode-test/**
src/**
esbuild.mjs
scripts/**

# `main` points at dist/, which is the whole extension in one file. out/ is tsc's output: it exists
# for type checking and for the integration tests, and shipping it would put a second, unused copy
# of every module in the .vsix - the copy whose 126 file opens this bundle exists to avoid.
out/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*

# The test suite and the workspace it runs against. `src/**` already keeps the sources out, but the
# compiled tests land in out/ alongside the extension itself and would otherwise ship.
out/test/**
test-fixtures/**
# Exclude test executables, libraries, debug symbols, and experimental binaries from bin/
bin/angel_lsp-*
bin/*_tests*
bin/**/*.lib
bin/**/*.exp
bin/**/*.pdb



