.vscode/**
.vscode-test/**
src/**
esbuild.mjs
scripts/**

# `main` points at dist/, which is the whole extension in one file. out/ is tsc's output: it exists
# for type checking and for the integration tests, and shipping it would put a second, unused copy
# of every module in the .vsix - the copy whose 126 file opens this bundle exists to avoid.
out/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*

# The test suite and the workspace it runs against. `src/**` already keeps the sources out, but the
# compiled tests land in out/ alongside the extension itself and would otherwise ship.
out/test/**
test-fixtures/**

# Load-bearing. bin/ holds the compiled server and is now ignored by git - CI builds it per
# platform and stages it here before packaging. vsce reads this file rather than .gitignore, so
# this negation is the only thing keeping the server inside the .vsix. Removing it ships an
# extension that cannot start.
!bin/**
