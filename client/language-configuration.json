{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "colorizedBracketPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        {"open": "{", "close": "}"},
        {"open": "[", "close": "]"},
        {"open": "(", "close": ")"},
        {"open": "\"", "close": "\"", "notIn": ["string"]},
        {"open": "'", "close": "'", "notIn": ["string", "comment"]},
        {"open": "/**", "close": " */", "notIn": ["string"]}
    ],
    "autoCloseBefore": ";:.,=}])> \n\t",
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
        ["<", ">"]
    ],
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
    "folding": {
        "markers": {
            "start": "^\\s*(#|//\\s*#?|/\\*\\s*#?)region\\b",
            "end": "^\\s*(#|//\\s*#?|/\\*\\s*#?)endregion\\b"
        }
    },
    "indentationRules": {
        "increaseIndentPattern": "^((?!\\/\\/).)*(\\{[^}\"'`]*|\\([^)\"'`]*|\\[[^\\]\"'`]*)$",
        "decreaseIndentPattern": "^((?!.*?\\/\\*).*\\*/)?\\s*[\\)\\}\\]].*$",
        "indentNextLinePattern": "^\\s*(((if|else ?if|while|for|foreach)\\s*\\(.*\\)\\s*)|else\\s*|do\\s*)$",
        "unIndentedLinePattern": "^(\\t|[ ])*[ ]\\*[^/]*\\*/\\s*$|^(\\t|[ ])*[ ]\\*/\\s*$|^(\\t|[ ])*\\*([ ]([^\\*]|\\*(?!/))*)?$"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*\\/\\*\\*(?!\\/)([^\\*]|\\*(?!\\/))*$",
            "afterText": "^\\s*\\*\\/$",
            "action": {
                "indent": "indentOutdent",
                "appendText": " * "
            }
        },
        {
            "beforeText": "^\\s*\\/\\*\\*(?!\\/)([^\\*]|\\*(?!\\/))*$",
            "action": {
                "indent": "none",
                "appendText": " * "
            }
        },
        {
            "beforeText": "^(\\t|(\\ \\ ))*\\ \\*(\\ ([^\\*]|\\*(?!\\/))*)?$",
            "action": {
                "indent": "none",
                "appendText": "* "
            }
        },
        {
            "beforeText": "^(\\t|(\\ \\ ))*\\ \\*\\/\\s*$",
            "action": {
                "indent": "none",
                "removeText": 1
            }
        },
        {
            "previousLineText": "^\\s*(((else ?)?if|for(each)?|while)\\s*\\(.*\\)\\s*|else\\s*|do\\s*)$",
            "beforeText": "^\\s+([^{i\\s]|i(?!f\\b))",
            "action": {
                "indent": "outdent"
            }
        },
        {
            "beforeText": "^\\s*//\\s*\\S|\\s//\\s+\\S",
            "afterText": "^(?!\\s*$)",
            "action": {
                "indent": "none",
                "appendText": "// "
            }
        }
    ]
}