{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        {"open": "{", "close": "}"},
        {"open": "[", "close": "]"},
        {"open": "(", "close": ")"},
        {"open": "\"", "close": "\"", "notIn": ["string"]},
        {"open": "'", "close": "'", "notIn": ["string", "comment"]}
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
    "folding": {
        "markers": {
            "start": "^\\s*#region\\b",
            "end": "^\\s*#endregion\\b"
        }
    },
    "indentationRules": {
        "decreaseIndentPattern": {
            "pattern": "^\\s*[\\}\\]\\)].*$"
        },
        "increaseIndentPattern": {
            "pattern": "^.*(\\{[^}]*|\\([^)]*|\\[[^\\]]*)$"
        }
    },
    "onEnterRules": [
        {
            "previousLineText": "^\\s*(((else ?)?if|for|while)\\s*\\(.*\\)\\s*|else\\s*)$",
            "beforeText": "^\\s+([^{i\\s]|i(?!f\\b))",
            "action": {
                "indent": "outdent"
            }
        },
        {
            "beforeText": "^\\s*//\\s*\\S|\\s//\\s+\\S",
            "afterText": "^(?!\\s*$)",
            "action": {
                "indent": "none",
                "appendText": "// "
            }
        }
    ]
}