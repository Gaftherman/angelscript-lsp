{
  "name": "angelscript-gaftherman",
  "displayName": "Angelscript - Language Server for Angelscript",
  "description": "%extension.description%",
  "version": "0.9.27",
  "publisher": "Gaftherman",
  "license": "MIT",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "angelscript",
    "angel script",
    "as",
    "lsp",
    "language server",
    "sven co-op",
    "intellisense"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gaftherman/angelscript-lsp.git"
  },
  "bugs": {
    "url": "https://github.com/Gaftherman/angelscript-lsp/issues"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Custom server executable paths are disabled in untrusted workspaces."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "angelscript",
        "extensions": [
          ".as"
        ],
        "aliases": [
          "AngelScript",
          "angelscript"
        ],
        "icon": {
          "light": "./assets/as-file-icon.svg",
          "dark": "./assets/as-file-icon.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "angelscript-predefined",
        "extensions": [
          ".as.predefined",
          ".predefined"
        ],
        "filenames": [
          "as.predefined"
        ],
        "filenamePatterns": [
          "*.as.predefined",
          "*as.predefined",
          "*.predefined"
        ],
        "aliases": [
          "AngelScript Predefined Stubs"
        ],
        "icon": {
          "light": "./assets/as-predefined-icon.svg",
          "dark": "./assets/as-predefined-icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "angelscript.showServerLog",
        "title": "%command.showServerLog.title%",
        "category": "%command.showServerLog.category%"
      },
      {
        "command": "angelscript.openLogsFolder",
        "title": "%command.openLogsFolder.title%",
        "category": "%command.openLogsFolder.category%"
      },
      {
        "command": "angelscript.restartServer",
        "title": "%command.restartServer.title%",
        "category": "%command.restartServer.category%"
      },
      {
        "command": "angelscript.selectPredefined",
        "title": "%command.selectPredefined.title%",
        "category": "%command.selectPredefined.category%"
      },
      {
        "command": "angelscript.selectStubs",
        "title": "%command.selectStubs.title%",
        "category": "%command.selectPredefined.category%"
      },
      {
        "command": "angelscript.rescanWorkspace",
        "title": "%command.rescanWorkspace.title%",
        "category": "%command.selectPredefined.category%"
      },
      {
        "command": "angelscript.statusMenu",
        "title": "%command.statusMenu.title%",
        "category": "%command.selectPredefined.category%"
      },
      {
        "command": "angelscript.setModuleEntryPoint",
        "title": "%command.setModuleEntryPoint.title%",
        "category": "%command.selectPredefined.category%"
      },
      {
        "command": "angelscript.setModuleFolder",
        "title": "%command.setModuleFolder.title%",
        "category": "%command.selectPredefined.category%"
      },
      {
        "command": "angelscript.formatPredefinedStub",
        "title": "%command.formatPredefinedStub.title%",
        "category": "%command.selectPredefined.category%"
      },
      {
        "command": "angelscript.viewMixinExpansion",
        "title": "%command.viewMixinExpansion.title%",
        "category": "%command.selectPredefined.category%"
      },
      {
        "command": "angelscript.peekMixinInline",
        "title": "%command.peekMixinInline.title%",
        "category": "%command.selectPredefined.category%"
      },
      {
        "command": "angelscript.openPhysicalSource",
        "title": "%command.openPhysicalSource.title%",
        "category": "%command.selectPredefined.category%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "angelscript.setModuleEntryPoint",
          "when": "resourceExtname == .as",
          "group": "angelscript@1"
        },
        {
          "command": "angelscript.setModuleFolder",
          "when": "explorerResourceIsFolder",
          "group": "angelscript@2"
        },
        {
          "command": "angelscript.formatPredefinedStub",
          "when": "resourceExtname == .predefined",
          "group": "angelscript@3"
        }
      ],
      "commandPalette": [
        {
          "command": "angelscript.setModuleEntryPoint",
          "when": "false"
        },
        {
          "command": "angelscript.setModuleFolder",
          "when": "false"
        },
        {
          "command": "angelscript.openPhysicalSource",
          "when": "false"
        },
        {
          "command": "angelscript.peekMixinInline",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "angelscript.formatPredefinedStub",
          "when": "resourceExtname == .predefined",
          "group": "angelscript@1"
        },
        {
          "command": "angelscript.viewMixinExpansion",
          "when": "editorLangId == angelscript",
          "group": "angelscript@2"
        }
      ]
    },
    "grammars": [
      {
        "language": "angelscript",
        "scopeName": "source.angelscript",
        "path": "./syntaxes/angelscript.tmLanguage.json"
      },
      {
        "language": "angelscript-predefined",
        "scopeName": "source.angelscript",
        "path": "./syntaxes/angelscript.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "templatePunctuation",
        "description": "The '<' and '>' delimiting a template argument list. Separate from 'operator' because the TextMate grammar cannot tell '>>' closing two templates from the right-shift operator; the server can, and this is the type it reports them as."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "angelscript",
        "scopes": {
          "templatePunctuation": [
            "punctuation.definition.typeparameters.angelscript",
            "punctuation.definition.typeparameters.begin.ts",
            "meta.type.parameters"
          ],
          "type.defaultLibrary": [
            "storage.type.built-in.primitive.angelscript",
            "storage.type.built-in",
            "storage.type"
          ]
        }
      },
      {
        "language": "angelscript-predefined",
        "scopes": {
          "templatePunctuation": [
            "punctuation.definition.typeparameters.angelscript",
            "punctuation.definition.typeparameters.begin.ts",
            "meta.type.parameters"
          ],
          "type.defaultLibrary": [
            "storage.type.built-in.primitive.angelscript",
            "storage.type.built-in",
            "storage.type"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "angelscript",
        "path": "./snippets/angelscript.json"
      },
      {
        "language": "angelscript-predefined",
        "path": "./snippets/angelscript.json"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.as.predefined": "angelscript-predefined",
        "as.predefined": "angelscript-predefined",
        "*.predefined": "angelscript-predefined"
      },
      "[angelscript]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.wordBasedSuggestions": "off",
        "editor.semanticHighlighting.enabled": true
      },
      "[angelscript-predefined]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.wordBasedSuggestions": "off",
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": [
      {
        "order": 1,
        "title": "%config.category.general%",
        "properties": {
          "angelscript.server.executablePath": {
            "type": "string",
            "scope": "machine",
            "default": "",
            "markdownDescription": "%config.server.executablePath.description%"
          },
          "angelscript.server.logLevel": {
            "type": "string",
            "default": "debug",
            "enum": [
              "error",
              "warn",
              "info",
              "debug",
              "trace"
            ],
            "markdownDescription": "%config.server.logLevel.description%",
            "markdownEnumDescriptions": [
              "%config.server.logLevel.error%",
              "%config.server.logLevel.warn%",
              "%config.server.logLevel.info%",
              "%config.server.logLevel.debug%",
              "%config.server.logLevel.trace%"
            ]
          },
          "angelscript.statusBar.alignment": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "enumDescriptions": [
              "%config.statusBar.alignment.left%",
              "%config.statusBar.alignment.right%"
            ],
            "default": "left",
            "markdownDescription": "%config.statusBar.alignment.description%"
          },
          "angelscript.dimInactiveRegions": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.dimInactiveRegions.description%"
          },
          "angelscript.inactiveRegionOpacity": {
            "type": "number",
            "default": 0.55,
            "minimum": 0.1,
            "maximum": 1,
            "markdownDescription": "%config.inactiveRegionOpacity.description%"
          }
        }
      },
      {
        "order": 2,
        "title": "%config.category.workspace%",
        "properties": {
          "angelscript.modules": {
            "type": "array",
            "scope": "resource",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "folder": {
                  "type": "string"
                },
                "entry": {
                  "type": "string"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "name",
                    "folder"
                  ]
                },
                {
                  "required": [
                    "name",
                    "entry"
                  ]
                }
              ],
              "additionalProperties": false
            },
            "markdownDescription": "%config.modules.description%"
          },
          "angelscript.moduleEntryPoint": {
            "type": "string",
            "scope": "resource",
            "default": "",
            "markdownDescription": "%config.moduleEntryPoint.description%"
          },
          "angelscript.searchDirectories": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.searchDirectories.description%"
          },
          "angelscript.predefined.active": {
            "type": "string",
            "scope": "resource",
            "default": "",
            "markdownDescription": "%config.predefined.active.description%"
          },
          "angelscript.predefinedFiles": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.predefinedFiles.description%"
          },
          "angelscript.stubs.activeFiles": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.stubs.activeFiles.description%"
          },
          "angelscript.include.implicitExtension": {
            "type": "boolean",
            "scope": "resource",
            "default": false,
            "markdownDescription": "%config.include.implicitExtension.description%"
          },
          "angelscript.forceIncludeFiles": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.forceIncludeFiles.description%"
          },
          "angelscript.exclude": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "string"
            },
            "default": [
              "**/.git/**",
              "**/build/**",
              "**/node_modules/**"
            ],
            "markdownDescription": "%config.exclude.description%"
          },
          "angelscript.fileExtension": {
            "type": "string",
            "scope": "resource",
            "default": ".as",
            "markdownDescription": "%config.fileExtension.description%"
          },
          "angelscript.predefinedExtension": {
            "type": "string",
            "scope": "resource",
            "default": ".as.predefined",
            "markdownDescription": "%config.predefinedExtension.description%"
          },
          "angelscript.define": {
            "type": "array",
            "scope": "resource",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.define.description%"
          },
          "angelscript.arrayLikeTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "%config.arrayLikeTypes.description%"
          },
          "angelscript.enableVirtualMixinDocuments": {
            "type": "boolean",
            "default": false,
            "scope": "resource",
            "markdownDescription": "%angelscript.enableVirtualMixinDocuments.description%"
          }
        }
      },
      {
        "order": 3,
        "title": "%config.category.inlayHints%",
        "properties": {
          "angelscript.features.inlayHints": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.inlayHints.description%"
          },
          "angelscript.inlayHints.maxParameters": {
            "type": "integer",
            "scope": "resource",
            "default": 0,
            "minimum": 0,
            "markdownDescription": "%config.inlayHints.maxParameters.description%"
          },
          "angelscript.inlayHints.maxLength": {
            "type": "integer",
            "scope": "resource",
            "default": 0,
            "minimum": 0,
            "markdownDescription": "%config.inlayHints.maxLength.description%"
          },
          "angelscript.inlayHints.suppressWhenArgumentMatchesName": {
            "type": "boolean",
            "default": false,
            "scope": "resource",
            "markdownDescription": "%angelscript.inlayHints.suppressWhenArgumentMatchesName.description%"
          },
          "angelscript.inlayHints.enableTooltip": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "markdownDescription": "%config.inlayHints.enableTooltip.description%"
          },
          "angelscript.inlayHints.enableLocation": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "markdownDescription": "%config.inlayHints.enableLocation.description%"
          },
          "angelscript.inlayHints.omittedDefaultArguments": {
            "type": "string",
            "scope": "resource",
            "enum": [
              "nameAndValue",
              "declaration",
              "off"
            ],
            "enumDescriptions": [
              "%config.inlayHints.omittedDefaultArguments.nameAndValue%",
              "%config.inlayHints.omittedDefaultArguments.declaration%",
              "%config.inlayHints.omittedDefaultArguments.off%"
            ],
            "default": "nameAndValue",
            "markdownDescription": "%config.inlayHints.omittedDefaultArguments.description%"
          }
        }
      },
      {
        "order": 4,
        "title": "%config.category.formatting%",
        "properties": {
          "angelscript.features.formatting": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.formatting.description%"
          },
          "angelscript.features.onTypeFormatting": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.onTypeFormatting.description%"
          },
          "angelscript.format.onSave": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.format.onSave.description%"
          },
          "angelscript.format.braceStyle": {
            "type": "string",
            "enum": [
              "allman",
              "kr"
            ],
            "enumDescriptions": [
              "%config.format.braceStyle.enum.0%",
              "%config.format.braceStyle.enum.1%"
            ],
            "default": "allman",
            "description": "%config.format.braceStyle.description%"
          },
          "angelscript.format.spacesInsideParentheses": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.format.spacesInsideParentheses.description%"
          },
          "angelscript.format.keepEmptyBlocksOnSingleLine": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.format.keepEmptyBlocksOnSingleLine.description%"
          }
        }
      },
      {
        "order": 5,
        "title": "%config.category.features%",
        "properties": {
          "angelscript.features.hover": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.hover.description%"
          },
          "angelscript.hover.stringLiteralLength": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "markdownDescription": "%config.hover.stringLiteralLength.description%"
          },
          "angelscript.hover.stringLiteralPathResolution": {
            "type": "boolean",
            "default": false,
            "scope": "resource",
            "markdownDescription": "%config.hover.stringLiteralPathResolution.description%"
          },
          "angelscript.hover.assetSearchPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "resource",
            "markdownDescription": "%config.hover.assetSearchPaths.description%"
          },
          "angelscript.features.completion": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.completion.description%"
          },
          "angelscript.completion.smartTypeRanking": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "markdownDescription": "%config.completion.smartTypeRanking.description%"
          },
          "angelscript.completion.completeFunctionParens": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "markdownDescription": "%config.completion.completeFunctionParens.description%"
          },
          "angelscript.completion.qualifyEnumValues": {
            "type": "boolean",
            "default": true,
            "scope": "resource",
            "markdownDescription": "%config.completion.qualifyEnumValues.description%"
          },
          "angelscript.features.definition": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.definition.description%"
          },
          "angelscript.features.references": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.references.description%"
          },
          "angelscript.features.signatureHelp": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.signatureHelp.description%"
          },
          "angelscript.features.semanticTokens": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.semanticTokens.description%"
          },
          "angelscript.features.documentSymbols": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.documentSymbols.description%"
          },
          "angelscript.features.workspaceSymbols": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.workspaceSymbols.description%"
          },
          "angelscript.features.rename": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.rename.description%"
          },
          "angelscript.features.documentHighlight": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.documentHighlight.description%"
          },
          "angelscript.features.foldingRange": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.foldingRange.description%"
          },
          "angelscript.features.codeAction": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.codeAction.description%"
          },
          "angelscript.features.documentLink": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.documentLink.description%"
          },
          "angelscript.features.implementation": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.implementation.description%"
          },
          "angelscript.features.selectionRange": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.selectionRange.description%"
          },
          "angelscript.features.callHierarchy": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.callHierarchy.description%"
          },
          "angelscript.features.typeHierarchy": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.typeHierarchy.description%"
          },
          "angelscript.features.linkedEditing": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.linkedEditing.description%"
          },
          "angelscript.features.codeLens": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.codeLens.description%"
          },
          "angelscript.features.pullDiagnostics": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.pullDiagnostics.description%"
          },
          "angelscript.features.typeConversionChecks": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.typeConversionChecks.description%"
          },
          "angelscript.features.predefinedLoader": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.predefinedLoader.description%"
          },
          "angelscript.features.enableCommentSuppressions": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.features.enableCommentSuppressions.description%"
          }
        }
      },
      {
        "order": 6,
        "title": "%config.category.diagnostics%",
        "properties": {
          "angelscript.diagnosticSeverity": {
            "type": "object",
            "scope": "resource",
            "default": {},
            "additionalProperties": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "information",
                "hint"
              ]
            },
            "markdownDescription": "%config.diagnosticSeverity.description%"
          },
          "angelscript.diagnostics.reportUnknownTypes": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.diagnostics.reportUnknownTypes.description%"
          },
          "angelscript.diagnostics.reportAccessorPortability": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.diagnostics.reportAccessorPortability.description%"
          },
          "angelscript.diagnostics.reportAccessorDisabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.diagnostics.reportAccessorDisabled.description%"
          },
          "angelscript.diagnostics.reportBoolConversion": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.diagnostics.reportBoolConversion.description%"
          },
          "angelscript.diagnostics.reportMissingFuncdef": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.diagnostics.reportMissingFuncdef.description%"
          },
          "angelscript.diagnostics.reportIntegerDivision": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.diagnostics.reportIntegerDivision.description%"
          },
          "angelscript.diagnostics.reportPossibleNullDereference": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.diagnostics.reportPossibleNullDereference.description%"
          },
          "angelscript.diagnostics.reportHandleComparisonEquality": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "enumDescriptions": [
              "Disabled",
              "Warning (implicit conversion to handle)",
              "Error (strict handle identity required)"
            ],
            "default": 1,
            "markdownDescription": "%config.diagnostics.reportHandleComparisonEquality.description%"
          },
          "angelscript.diagnostics.missingAssetPathSeverity": {
            "type": "string",
            "enum": [
              "off",
              "hint",
              "warning",
              "error"
            ],
            "enumDescriptions": [
              "Disabled",
              "Information hint",
              "Warning",
              "Error"
            ],
            "default": "off",
            "markdownDescription": "%config.diagnostics.missingAssetPathSeverity.description%"
          }
        }
      },
      {
        "order": 7,
        "title": "%config.category.engine%",
        "properties": {
          "angelscript.engine.allowUnsafeReferences": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.engine.allowUnsafeReferences.description%"
          },
          "angelscript.engine.privatePropAsProtected": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.engine.privatePropAsProtected.description%"
          },
          "angelscript.engine.disallowGlobalVars": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.engine.disallowGlobalVars.description%"
