{
  "name": "engine-options",
  "file": "MedkitPlugin.as",
  "zoomIn": 1,
  "wholeLineMargin": 16,
  "setup": {
    "action": "splitRight",
    "tab": ".vscode/settings.json"
  },
  "editorSettings": {
    "editor.fontSize": 17,
    "editor.lineHeight": 28,
    "editor.padding.top": 26,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": false,
    "editor.suggestOnTriggerCharacters": false
  },
  "steps": [
    { "action": "wait", "ms": 380 },
    { "action": "smoothScroll", "toToken": "g_MainStation", "lineIncludes": "MedkitStation g_MainStation", "targetY": 555 },
    { "action": "hold", "ms": 430 },
    { "action": "moveCursor", "toToken": "false", "lineIncludes": "\"angelscript.engine.disallowGlobalVars\"", "duration": 540 },
    { "action": "click", "clickCount": 2 },
    { "action": "type", "text": "true", "delay": 75 },
    { "action": "press", "key": "Control+s" },
    { "action": "hold", "ms": 450 },
    { "action": "moveCursor", "toToken": "g_MainStation", "lineIncludes": "MedkitStation g_MainStation", "duration": 590 },
    { "action": "ensureHover", "expect": ["E145", "Global variable 'g_MainStation' is not allowed: global variables have been disabled by the application.", "MedkitStation::MedkitStation", "float healPower = 25.0f"], "fullyVisible": true },
    { "action": "hold", "ms": 2250 }
  ]
}
