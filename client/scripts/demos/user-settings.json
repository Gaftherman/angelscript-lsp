{
  "security.workspace.trust.enabled": false,
  "security.workspace.trust.startupPrompt": "never",
  "workbench.colorTheme": "Dark Modern",
  "workbench.editor.showTabs": "multiple",
  "editor.fontSize": 20,
  "editor.lineHeight": 32,
  "editor.padding.top": 36,
  "editor.padding.bottom": 36,
  "editor.hover.delay": 100,
  "editor.hover.sticky": true,
  "editor.fontFamily": "Consolas, 'Courier New', monospace",
  "editor.minimap.enabled": false,
  "editor.renderLineHighlight": "line",
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.wordBasedSuggestions": "off",
  "editor.inlayHints.enabled": "on",
  "editor.inlayHints.fontSize": 20,
  "editor.stickyScroll.enabled": false,
  "workbench.colorCustomizations": {
    "editorInlayHint.foreground": "#e5c07b",
    "editorInlayHint.background": "#2c313c",
    "editorInlayHint.parameterForeground": "#61afef",
    "editorInlayHint.typeForeground": "#e5c07b"
  },
  "editor.codeLens": true,
  "editor.codeLensFontSize": 20,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.semanticHighlighting.enabled": true,
  "editor.suggest.preview": true,
  "editor.suggest.showStatusBar": false,
  "breadcrumbs.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": false,
  "workbench.layoutControl.enabled": false,
  "workbench.tips.enabled": false,
  "workbench.startupEditor": "none",
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "window.zoomLevel": 0,
  "window.customTitleBarVisibility": "never",
  "git.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "git.autorefresh": false,
  "chat.commandCenter.enabled": false,
  "github.copilot.enable": {
    "*": false
  },
  "window.titleBarStyle": "native",
  "window.commandCenter": false,
  "chat.disableAIFeatures": true,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "editor.hover.above": true,
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingQuotes": "never"
}
