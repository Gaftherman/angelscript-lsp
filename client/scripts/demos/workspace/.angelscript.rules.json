{
  "name": "Demo Safety Rules",
  "engineProperties": {
    "propertyAccessorMode": 2,
    "requireEnumScope": false
  },
  "storageRules": [
    {
      "id": "unsafe-entity-handle",
      "inheritsFrom": "CBaseEntity",
      "typeRegex": "CBase.*",
      "handleOnly": true,
      "disallowInMembers": true,
      "suggestReplacement": "EHandle",
      "message": "Entity handle '{}' in member field can dangle; store 'EHandle' instead.",
      "severity": "warning"
    }
  ]
}
