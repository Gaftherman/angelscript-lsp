{
  "$schema": "https://raw.githubusercontent.com/Gaftherman/angelscript-lsp/main/schemas/angelscript.rules.schema.json",
  "name": "Sven Co-op Engine Safety Rules",
  "engineProperties": {
    "propertyAccessorMode": 2,
    "disallowGlobalVars": false,
    "requireEnumScope": false,
    "allowUnsafeReferences": false
  },
  "storageRules": [
    {
      "id": "unsafe-entity-handle",
      "inheritsFrom": "CBaseEntity",
      "typeRegex": "CBase.*",
      "handleOnly": true,
      "disallowInMembers": true,
      "disallowInArrays": true,
      "suggestReplacement": "EHandle",
      "message": "Entity handle '{}' in member or array can dangle if removed by engine; store 'EHandle' instead.",
      "severity": "warning"
    },
    {
      "id": "custom-keyvalue-local-only",
      "types": ["CustomKeyvalue"],
      "disallowInMembers": true,
      "disallowInGlobals": true,
      "disallowInArrays": true,
      "message": "'CustomKeyvalue' should only be used as a local variable and must not be stored.",
      "severity": "warning"
    }
  ],
  "typeSuggestions": [
    {
      "id": "prefer-regular-string",
      "fromType": "string_t",
      "toType": "string",
      "appliesTo": ["local", "member", "param"],
      "message": "Consider using regular 'string' instead of 'string_t' to avoid engine string pool allocations.",
      "severity": "hint"
    }
  ],
  "callRules": [
    {
      "id": "scheduler-safety",
      "callee": "g_Scheduler",
      "methods": ["SetTimeout", "SetInterval"],
      "disallowArgInheritsFrom": "CBaseEntity",
      "disallowArgRegex": "CBase.*",
      "disallowArgHandleOnly": true,
      "argSuggestReplacement": "EHandle",
      "requireExplicitEnumConstruct": true,
      "message": "Passing raw entity handle to scheduled callback is unsafe. Use 'EHandle'.",
      "severity": "warning"
    },
    {
      "id": "custom-keyvalues-setkeyvalue-defect",
      "callee": "CustomKeyvalues",
      "methods": ["SetKeyvalue"],
      "disallowMethod": true,
      "suggestReplacement": "g_EntityFuncs.DispatchKeyValue",
      "message": "Calling 'CustomKeyvalues::SetKeyvalue' causes memory corruption and crashes on GetKeyvalue in Sven Co-op <= 5.26. Use 'g_EntityFuncs.DispatchKeyValue' instead.",
      "severity": "warning"
    }
  ],
  "unusedSymbolRules": {
    "enabled": true,
    "checkLocals": true,
    "checkMembers": true,
    "checkGlobals": true,
    "ignoreUnusedGlobalsWithCallInitializer": false,
    "unusedGlobalExemptTypes": [
      "CClientCommand",
      "CConCommand",
      "CCVar",
      "CScheduledFunction"
    ],
    "checkFunctions": true,
    "checkClasses": true,
    "ignoredGlobalFunctions": [
      "PluginInit",
      "PluginExit",
      "MapInit",
      "MapStart",
      "MapActivate"
    ],
    "engineCallbackSignatures": [
      ["CBaseEntity@", "CBaseEntity@", "USE_TYPE", "float"]
    ],
    "ignoredBaseClasses": [
      "ScriptBaseEntity",
      "ScriptBaseAnimating",
      "ScriptBaseMonsterEntity",
      "ScriptBaseTankEntity",
      "ScriptBasePlayerItemEntity",
      "ScriptBasePlayerWeaponEntity",
      "ScriptBaseItemEntity",
      "ScriptBasePlayerAmmoEntity",
      "ScriptBaseCustomEntity",
      "ScriptClassInterface"
    ],
    "baseClassDelegateProperties": [
      "BaseClass"
    ],
    "baseClassProxyMap": {
      "ScriptBaseEntity": ["BaseEntity", "CBaseEntity"],
      "ScriptBaseAnimating": ["BaseEntity", "CBaseAnimating"],
      "ScriptBaseMonsterEntity": ["BaseMonster", "CBaseMonster"],
      "ScriptBaseTankEntity": ["BaseTank", "CBaseTank"],
      "ScriptBasePlayerItemEntity": ["BasePlayerItem", "CBasePlayerItem"],
      "ScriptBasePlayerWeaponEntity": ["BasePlayerWeapon", "CBasePlayerWeapon"],
      "ScriptBasePlayerAmmoEntity": ["BasePlayerAmmo", "CBasePlayerAmmo"],
      "ScriptBaseItemEntity": ["BaseItem", "CItem"]
    },
    "stringReflectionCallees": [
      {
        "callee": "g_CustomEntityFuncs",
        "methods": ["RegisterCustomEntity", "UnRegisterCustomEntity"],
        "argIndices": [0]
      },
      {
        "callee": "g_Scheduler",
        "methods": ["SetTimeout", "SetInterval"],
        "argIndices": [0]
      },
      {
        "callee": "g_ItemRegistry",
        "methods": ["RegisterWeapon"],
        "argIndices": [4, 5]
      }
    ]
  }
}
