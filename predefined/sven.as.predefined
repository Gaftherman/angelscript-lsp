// Handle to the activator.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
EHandle m_hActivator;
// Closed position.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
Vector m_vecPosition1;
// Open position.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
Vector m_vecPosition2;
// Closed angle.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
Vector m_vecAngle1;
// Open angle.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
Vector m_vecAngle2;
// Final destination.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
Vector m_vecFinalDest;
// Final angle.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
Vector m_vecFinalAngle;
// DMG_ damage type that the door or trigger does.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
int m_bitsDamageInflict;
// This entity's master, if any.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
string_t m_sMaster;
// Implicitly casts to base type.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
