// Returns whether this weapon should reload automatically.
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayerWeapon.htm
bool ShouldReload();
// called when no buttons pressed.
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayerWeapon.htm
