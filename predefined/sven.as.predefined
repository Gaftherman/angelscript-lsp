namespace Regex {
// Performs are regular expression matching operation.
// Returns true if the match succeeded, false otherwise.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
bool Match(const string& in szString, const Regex@ pRegex, MatchFlagType flags = match_default);
}

namespace Regex {
// Performs are regular expression matching operation.
// Returns true if the match succeeded, false otherwise.
// pResults will contain the results of the operation, if any.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
bool Match(const string& in szString, MatchResults@ pResults, const Regex@ pRegex, MatchFlagType flags = match_default);
}

namespace Regex {
// Returns whether some sub-sequence in the target sequence (the subject) matches the regular expression pRegex.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
bool Search(const string& in szString, const Regex@ pRegex, MatchFlagType flags = match_default);
}

namespace Regex {
// Returns whether some sub-sequence in the target sequence (the subject) matches the regular expression pRegex.
// pResults will contain the results of the operation, if any.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
bool Search(const string& in szString, MatchResults@ pResults, const Regex@ pRegex, MatchFlagType flags = match_default);
}

namespace Regex {
// Makes a copy of the target sequence (the subject) with all matches of the regular expression pRegex (the pattern) replaced by szFormat (the replacement).
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
string Replace(const string& in szString, const Regex@ pRegex, const string& in szFormat, MatchFlagType flags = match_default);
}

namespace FileSystem {
// Returns whether the given open flags are valid.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
bool FlagsValid(const OpenFileFlags_t uiOpenFlags);
}

namespace FileSystem {
// Filters the given flags, removing unnecessary flags.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
OpenFileFlags_t FilterFlags(OpenFileFlags_t uiOpenFlags);
}

namespace FileSystem {
// Formats the open flags into a string that represents the flags.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
bool FormatOpenFlags(OpenFileFlags_t uiOpenFlags, string& out szOutFlags);
}

// Gets the current script's scheduler.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
CScheduler@ get_g_Scheduler() property;

// Returns a dot product of the given vectors.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
float DotProduct(const Vector2D& in lhs, const Vector2D& in rhs);

// Returns the dot product of the given vectors.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
float DotProduct(const Vector& in lhs, const Vector& in rhs);

// Returns the cross product of the given vectors.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
Vector CrossProduct(const Vector& in, const Vector& in);

// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
int TrainSpeed(int iSpeed, int iMax);

// Checks edict for nullity.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
bool FNullEnt(const edict_t@ pEnt);

// Checks entvars for nullity.
//
// @link https://r4to0.github.io/asautodocs/docs/Functions.htm
bool FNullEnt(entvars_t@ pev);

// Gets the current global sound manager entity.
