// Gets the current schedule.
//
// @link https://r4to0.github.io/asautodocs/docs/CGrenade.htm
Schedule@ GetSchedule();
// Called after the monster's schedule changes.
//
// @link https://r4to0.github.io/asautodocs/docs/CGrenade.htm
