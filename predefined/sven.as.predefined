//
// @link https://r4to0.github.io/asautodocs/docs/CBaseAnimating.htm
bool opEquals(CBaseEntity@ pOther);
// Precaches the entity. Do not call directly.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseAnimating.htm
void Precache();
