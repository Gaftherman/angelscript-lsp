// Class name out filter type.
//
// @link https://r4to0.github.io/asautodocs/docs/CLaser.htm
string_t classnameOutFilterType;
// Target name in filter type.
//
// @link https://r4to0.github.io/asautodocs/docs/CLaser.htm
