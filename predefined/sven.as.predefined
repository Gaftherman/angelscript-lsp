//
// @link https://r4to0.github.io/asautodocs/docs/CBaseMonster.htm
Vector m_vecPosition1;
// Open position.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseMonster.htm
Vector m_vecPosition2;
// Closed angle.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseMonster.htm
Vector m_vecAngle1;
// Open angle.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseMonster.htm
Vector m_vecAngle2;
// Final destination.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseMonster.htm
