//
// @link https://r4to0.github.io/asautodocs/docs/ObserverMode.htm
OBS_ENTERING = -1,
// Player not in observer mode.
//
// @link https://r4to0.github.io/asautodocs/docs/ObserverMode.htm
OBS_NONE = 0,
// Chase locked.
//
// @link https://r4to0.github.io/asautodocs/docs/ObserverMode.htm
OBS_CHASE_LOCKED = 3,
// Free movement.
//
// @link https://r4to0.github.io/asautodocs/docs/ObserverMode.htm
OBS_CHASE_FREE = 1,
// Roaming.
//
// @link https://r4to0.github.io/asautodocs/docs/ObserverMode.htm
OBS_ROAMING = 2,
}

// Bit field values for entvars_t.buttons.
// Used by players to determine which buttons have been pressed.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
enum In_Buttons {
// Primary attack.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_ATTACK = 1,
// Jump.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_JUMP = 2,
// Duck.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_DUCK = 4,
// Move forward.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_FORWARD = 8,
// Move backward.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_BACK = 16,
// Use.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_USE = 32,
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_CANCEL = 64,
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_LEFT = 128,
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_RIGHT = 256,
// Move left.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_MOVELEFT = 512,
// Move right.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_MOVERIGHT = 1024,
// Secondary attack.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_ATTACK2 = 2048,
// Run/Walk.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_RUN = 4096,
// Reload.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_RELOAD = 8192,
// Tertiary attack.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_ALT1 = 16384,
// Used by client.dll for when scoreboard is held down.
//
// @link https://r4to0.github.io/asautodocs/docs/In_Buttons.htm
IN_SCORE = 32768,
}

