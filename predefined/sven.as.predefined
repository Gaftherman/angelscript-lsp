// Break model defines for message SVC_TEMPENTITY::TE_BREAKMODEL.
//
// @link https://r4to0.github.io/asautodocs/docs/BREAK.htm
enum BREAK {
// Bit mask for all BREAK types.
//
// @link https://r4to0.github.io/asautodocs/docs/BREAK.htm
BREAK_TYPEMASK = 79,
