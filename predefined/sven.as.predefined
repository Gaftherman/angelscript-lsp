// Current toggle state.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
TOGGLE_STATE m_toggle_state;
// How far a door should slide or rotate.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
