// Player Weapon entity base class.
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayerWeapon.htm
class CBasePlayerWeapon {
// Entity variables.
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayerWeapon.htm
entvars_t@ pev;
