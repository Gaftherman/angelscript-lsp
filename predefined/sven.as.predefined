//
// @link https://r4to0.github.io/asautodocs/docs/CGrenade.htm
bool HasHumanGibs();
// Returns whether this monster has alien gibs.
//
// @link https://r4to0.github.io/asautodocs/docs/CGrenade.htm
bool HasAlienGibs();
// Fades this monster.
// Note: does not kill the monster.
//
// @link https://r4to0.github.io/asautodocs/docs/CGrenade.htm
void FadeMonster();
