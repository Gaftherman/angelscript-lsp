// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
void DoorGoDown();
// If the door is moving, changes the movement direction. Returns true if the door was moving.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseDoor.htm
bool DoorChangeDirection();
}

// Gib class.
