bool HasBeenAdded() const;
// Constructor.
//
// @link https://r4to0.github.io/asautodocs/docs/CClientCommand.htm
CClientCommand(const string& in szName, const string& in szHelpInfo, ClientCommandCallback@ pCallback, const ConCommandFlags_t flags = ConCommandFlag::None);
}

// CVar class.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
class CCVar {
// Gets the name of this command.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
const string& GetName() const;
// Gets the fully qualified name of this command. This is the name that the command is referred by when called.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
const string& GetFullyQualifiedName() const;
// Gets the help info describing this command.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
const string& GetHelpInfo() const;
// Gets the type of this console command.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
ConCommandKind::Type GetKind() const;
// Gets the name of the module that owns (created) this command.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
const string& GetOwningModuleName() const;
// Whether this command was added to the list of commands.
// Must be added to be usable from the console.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
bool HasBeenAdded() const;
// Constructor.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
CCVar(const string& in szName, float flValue = 0, const string& in szHelpInfo = "", const ConCommandFlags_t flags = ConCommandFlag::None, CVarCallback@ pCallback = null);
// Constructor.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
CCVar(const string& in szName, const string& in szValue, const string& in szHelpInfo = "", const ConCommandFlags_t flags = ConCommandFlag::None, CVarCallback@ pCallback = null);
// Gets the default value for this cvar.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
const string& GetDefaultValue() const;
// Converts the value to a string.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
const string& GetString() const;
// Converts the value to a float.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
float GetFloat() const;
// Converts the value to an integer.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
int GetInt() const;
// Converts the value to a boolean.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
bool GetBool() const;
// Sets the given string as the value.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
void SetString(const string& in szValue);
// Sets the given float as the value.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
void SetFloat(const float flValue);
// Sets the given integer as the value.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
void SetInt(const int iValue);
// Sets the given boolean as the value.
//
// @link https://r4to0.github.io/asautodocs/docs/CCVar.htm
void SetBool(const bool bValue);
}

// Script console command manager.
//
// @link https://r4to0.github.io/asautodocs/docs/CConCommandSystem.htm
class CConCommandSystem {
