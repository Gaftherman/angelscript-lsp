// @link https://r4to0.github.io/asautodocs/docs/Typedefs.htm
typedef uint32 ConCommandFlags_t;

namespace String {
// Compare type.
//
// @link https://r4to0.github.io/asautodocs/docs/CompareType.htm
enum CompareType {
// @link https://r4to0.github.io/asautodocs/docs/CompareType.htm
CaseSensitive = 0,
// @link https://r4to0.github.io/asautodocs/docs/CompareType.htm
CaseInsensitive = 1,
}
}

namespace Reflection {
// Which type a reflection argument is.
//
// @link https://r4to0.github.io/asautodocs/docs/ArgumentType.htm
enum ArgumentType {
// Argument has no type. If an argument has this type it means something went wrong during parsing.
//
// @link https://r4to0.github.io/asautodocs/docs/ArgumentType.htm
AT_NONE = 1,
// Argument is void.
//
// @link https://r4to0.github.io/asautodocs/docs/ArgumentType.htm
AT_VOID = 2,
// Argument is a primitive type.
//
// @link https://r4to0.github.io/asautodocs/docs/ArgumentType.htm
AT_PRIMITIVE = 4,
// Argument is an object type.
//
// @link https://r4to0.github.io/asautodocs/docs/ArgumentType.htm
AT_OBJECT = 24,
// Argument is an enum type.
//
// @link https://r4to0.github.io/asautodocs/docs/ArgumentType.htm
AT_ENUM = 32,
}
}

namespace Regex {
// Regular expression flags. These can be bitwise OR'd together to combine options.
//
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
enum FlagType {
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
icase = 256,
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
nosubs = 512,
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
optimize = 1024,
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
collate = 2048,
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
ECMAScript = 1,
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
basic = 2,
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
extended = 4,
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
awk = 8,
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
grep = 16,
// @link https://r4to0.github.io/asautodocs/docs/FlagType.htm
egrep = 32,
}
}

namespace Regex {
// Match format flags. These can be bitwise OR'd together to combine options.
//
// @link https://r4to0.github.io/asautodocs/docs/MatchFlagType.htm
enum MatchFlagType {
// @link https://r4to0.github.io/asautodocs/docs/MatchFlagType.htm
match_default = 0,
// @link https://r4to0.github.io/asautodocs/docs/MatchFlagType.htm
match_not_bol = 1,
// @link https://r4to0.github.io/asautodocs/docs/MatchFlagType.htm
match_not_eol = 2,
// @link https://r4to0.github.io/asautodocs/docs/MatchFlagType.htm
match_not_bow = 4,
// @link https://r4to0.github.io/asautodocs/docs/MatchFlagType.htm
match_not_eow = 8,
// @link https://r4to0.github.io/asautodocs/docs/MatchFlagType.htm
match_any = 16,
// @link https://r4to0.github.io/asautodocs/docs/MatchFlagType.htm
match_not_null = 32,
// @link https://r4to0.github.io/asautodocs/docs/MatchFlagType.htm
match_continuous = 64,
