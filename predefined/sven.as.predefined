// Called when this entity should be revived. flTimeUntilRevive is the time until the revival should start.
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayer.htm
void EndRevive(float flTimeUntilRevive);
// Add a entity flag mask (EFLAG).
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayer.htm
void AddEntityFlag(int FlagMask);
// Remove a entity flag mask (EFLAG).
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayer.htm
void RemoveEntityFlag(int FlagMask);
// Check if it has such entity flag mask (EFLAG) set.
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayer.htm
bool HasEntityFlag(int FlagMask) const;
// Clear all entity flag masks (EFLAG).
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayer.htm
void ClearEntityFlags();
// Gets the user data on this entity. Do not keep references to this data, the object might be removed from this entity.
