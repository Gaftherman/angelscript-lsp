// path_track spawnflags.
//
// @link https://r4to0.github.io/asautodocs/docs/PathTrackSpawnFlags.htm
enum PathTrackSpawnFlags {
// @link https://r4to0.github.io/asautodocs/docs/PathTrackSpawnFlags.htm
SF_PATH_DISABLED = 1,
// @link https://r4to0.github.io/asautodocs/docs/PathTrackSpawnFlags.htm
SF_PATH_FIREONCE = 2,
// @link https://r4to0.github.io/asautodocs/docs/PathTrackSpawnFlags.htm
SF_PATH_ALTREVERSE = 4,
// @link https://r4to0.github.io/asautodocs/docs/PathTrackSpawnFlags.htm
