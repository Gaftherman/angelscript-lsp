//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayerItem.htm
void Collect(CBaseEntity@ pOther);
// Attempts to let pOther collect this item, while specifying the collect type.
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayerItem.htm
