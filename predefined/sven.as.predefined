// These go in the flData member of TASK_WALK_TO_TARGET, TASK_RUN_TO_TARGET.
//
// @link https://r4to0.github.io/asautodocs/docs/TaskData.htm
enum TaskData {
// Move normally.
//
// @link https://r4to0.github.io/asautodocs/docs/TaskData.htm
