//
// @link https://r4to0.github.io/asautodocs/docs/Callable.htm
Function@ opCast();
// Explicitly casts to sub type.
//
// @link https://r4to0.github.io/asautodocs/docs/Callable.htm
Method@ opCast();
}
}

namespace Reflection {
// Reflection function class. Can be used to call global functions.
//
// @link https://r4to0.github.io/asautodocs/docs/Function.htm
class Function {
// Implicitly casts to base type.
//
// @link https://r4to0.github.io/asautodocs/docs/Function.htm
Callable@ opImplCast();
