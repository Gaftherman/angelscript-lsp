// Adds damage points to the inflicting entity.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseButton.htm
void GetDamagePoints(entvars_t@ pevAttacker, entvars_t@ pevInflictor, float flDamage);
// Entity constructor.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseButton.htm
void OnCreate();
// Entity destructor.
//
// @link https://r4to0.github.io/asautodocs/docs/CBaseButton.htm
