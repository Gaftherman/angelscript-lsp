// Remove a entity flag mask (EFLAG).
//
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
void RemoveEntityFlag(int FlagMask);
// Check if it has such entity flag mask (EFLAG) set.
//
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
bool HasEntityFlag(int FlagMask) const;
// Clear all entity flag masks (EFLAG).
//
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
void ClearEntityFlags();
// Gets the user data on this entity. Do not keep references to this data, the object might be removed from this entity.
// Only map scripts can use this.
//
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
dictionary@ GetUserData();
// Gets the user data stored under the specified key on this entity.
// Do not keep references to this data, the object might be removed from this entity.
// Only map scripts can use this.
//
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
dictionaryValue& GetUserData(const string& in szKey);
// Clears the user data on this entity. WARNING: clears all data.
// Only map scripts can use this.
//
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
void ClearUserData();
// Sets the previous track in this path.
//
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
void SetPrevious(CPathTrack@ pPrevious);
// Links the tracks together.
//
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
void Link();
// Returns pPath if enabled, null otherwise.
//
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
CPathTrack@ ValidPath(CPathTrack@ pPath, const bool testFlag);
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
void Project(CPathTrack@ pStart, CPathTrack@ pEnd, Vector& out vecOrigin, float flDist);
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
CPathTrack@ LookAhead(Vector& in vecOrigin, Vector& out vecResultOrigin, float flDist, const bool bMove);
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
CPathTrack@ Nearest(Vector vecOrigin);
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
CPathTrack@ GetNext();
// @link https://r4to0.github.io/asautodocs/docs/CPathTrack.htm
CPathTrack@ GetPrevious();
}

