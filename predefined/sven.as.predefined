// kRenderFxDistort + distance fade.
//
// @link https://r4to0.github.io/asautodocs/docs/RenderFX.htm
kRenderFxHologram = 16,
// kRenderAmt is the player index.
//
// @link https://r4to0.github.io/asautodocs/docs/RenderFX.htm
kRenderFxDeadPlayer = 17,
