//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayerWeapon.htm
void PrimaryAttack();
// do "+ATTACK2".
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayerWeapon.htm
void SecondaryAttack();
// do "+ATTACK3".
//
// @link https://r4to0.github.io/asautodocs/docs/CBasePlayerWeapon.htm
void TertiaryAttack();
