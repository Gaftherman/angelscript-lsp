//
// @link https://r4to0.github.io/asautodocs/docs/ScriptTask.htm
ScriptTask();
// Constructor.
//
// @link https://r4to0.github.io/asautodocs/docs/ScriptTask.htm
ScriptTask(int iTask, float flData = 0.0f);
}

// Script schedule class.
//
// @link https://r4to0.github.io/asautodocs/docs/ScriptSchedule.htm
class ScriptSchedule {
// Number of tasks in this schedule.
//
// @link https://r4to0.github.io/asautodocs/docs/ScriptSchedule.htm
int cTasks;
// A bit mask of conditions that can interrupt this schedule.
//
// @link https://r4to0.github.io/asautodocs/docs/ScriptSchedule.htm
int iInterruptMask;
// A more specific mask that indicates which TYPES of sounds will interrupt the schedule in the event that the schedule is broken by COND_HEAR_SOUND.
//
// @link https://r4to0.github.io/asautodocs/docs/ScriptSchedule.htm
int iSoundMask;
// Gets a task in this schedule.
// Must be between 0 and cTasks.
//
// @link https://r4to0.github.io/asautodocs/docs/ScriptSchedule.htm
Task@ GetTask(int iIndex) const;
// Gets the name of this schedule.
//
// @link https://r4to0.github.io/asautodocs/docs/ScriptSchedule.htm
string szName() const;
// Constructor.
//
// @link https://r4to0.github.io/asautodocs/docs/ScriptSchedule.htm
ScriptSchedule(int iInterruptMask, int iSoundMask, const string& in szName);
// Cast to Schedule.
//
// @link https://r4to0.github.io/asautodocs/docs/ScriptSchedule.htm
Schedule@ opImplCast();
// Adds a task to the list.
//
// @link https://r4to0.github.io/asautodocs/docs/ScriptSchedule.htm
void AddTask(const ScriptTask& in task);
}

// Waypoint for monsters to follow.
