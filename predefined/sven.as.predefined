edict_t@ GetClient() const;
// Gets a key value.
//
// @link https://r4to0.github.io/asautodocs/docs/KeyValueBuffer.htm
string GetValue(const string& in szKey) const;
// Sets a key value.
//
// @link https://r4to0.github.io/asautodocs/docs/KeyValueBuffer.htm
