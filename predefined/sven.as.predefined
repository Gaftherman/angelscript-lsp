// src.
//
// @link https://r4to0.github.io/asautodocs/docs/RenderModes.htm
kRenderNormal = 0,
// c*a.
//
// @link https://r4to0.github.io/asautodocs/docs/RenderModes.htm
kRenderTransColor = 1,
// src*a.
//
// @link https://r4to0.github.io/asautodocs/docs/RenderModes.htm
kRenderTransTexture = 2,
// src*a+dest -- No Z buffer checks.
//
// @link https://r4to0.github.io/asautodocs/docs/RenderModes.htm
kRenderGlow = 3,
// src*srca.
//
// @link https://r4to0.github.io/asautodocs/docs/RenderModes.htm
kRenderTransAlpha = 4,
// src*a.
//
// @link https://r4to0.github.io/asautodocs/docs/RenderModes.htm
kRenderTransAdd = 5,
}

// Render FX modes (entvars_t::renderfx).
//
// @link https://r4to0.github.io/asautodocs/docs/RenderFX.htm
enum RenderFX {
// @link https://r4to0.github.io/asautodocs/docs/RenderFX.htm
