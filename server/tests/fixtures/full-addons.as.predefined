// =====================================================================================
// A predefined stub covering the AngelScript SDK's standard add-ons.
//
// Written to exercise this server against a realistic host API surface: every add-on a typical
// embedding registers, with the signatures its `RegisterObjectMethod` / `RegisterGlobalFunction`
// calls actually use. It is a test fixture, not a template to copy blindly - your host registers
// some subset of this, under whatever names it chose.
//
// PROVENANCE. Two different levels of confidence, and it matters which is which:
//
//   * string, array, datetime, file, filesystem, dictionary, ref, Exception, optional and the
//     global functions are taken VERBATIM from AS-Harness's own as.predefined, which describes an
//     engine this repository can compile against. Anything written against them can be checked
//     with the real compiler (see server/tests/ParityAuditTest.cpp).
//
//   * weakref, const_weakref, grid, any, complex, the co-routine functions and `socket` are NOT
//     registered by AS-Harness. Their signatures come from the SDK add-on sources named above each
//     section. They are structurally verified here - the stub parses, the symbols resolve, and the
//     scripts using them draw no false diagnostics - but no oracle confirms them.
//
// LIST FACTORIES. `{ ... }` is only valid where the host registered an asBEHAVE_LIST_FACTORY, and
// the shape it accepts is written into that registration. The `@listpattern` tags below carry those
// patterns across; without one, this server stays silent about a type's initializer lists rather
// than guessing. See the README section "Initializer List Patterns".
// =====================================================================================


// =====================================================================================
// string - add_on/scriptstdstring/scriptstdstring.cpp (+ scriptstdstring_utils.cpp)
// =====================================================================================

class string{
	~string();
	string();
	string(const string&in);
	string& opAssign(const string&in);
	string& opAddAssign(const string&in);
	bool opEquals(const string&in) const;
	int opCmp(const string&in) const;
	string opAdd(const string&in) const;
	uint length() const;
	void resize(uint);
	bool isEmpty() const;
	uint8& opIndex(uint);
	const uint8& opIndex(uint) const;
	string& opAssign(double);
	string& opAddAssign(double);
	string opAdd(double) const;
	string opAdd_r(double) const;
	string& opAssign(float);
	string& opAddAssign(float);
	string opAdd(float) const;
	string opAdd_r(float) const;
	string& opAssign(int64);
	string& opAddAssign(int64);
	string opAdd(int64) const;
	string opAdd_r(int64) const;
	string& opAssign(uint64);
	string& opAddAssign(uint64);
	string opAdd(uint64) const;
	string opAdd_r(uint64) const;
	string& opAssign(bool);
	string& opAddAssign(bool);
	string opAdd(bool) const;
	string opAdd_r(bool) const;
	string substr(uint start = 0, int count = -1) const;
	int findFirst(const string&in, uint start = 0) const;
	int findFirstOf(const string&in, uint start = 0) const;
	int findFirstNotOf(const string&in, uint start = 0) const;
	int findLast(const string&in, int start = -1) const;
	int findLastOf(const string&in, int start = -1) const;
	int findLastNotOf(const string&in, int start = -1) const;
	void insert(uint pos, const string&in other);
	void erase(uint pos, int count = -1);
	int regexFind(const string&in regex, uint start = 0, uint&out lengthOfMatch = void) const;
	string[]@ split(const string&in) const;
}


// =====================================================================================
// array<T> - add_on/scriptarray/scriptarray.cpp
//
// The list factory registration reads:
//   asBEHAVE_LIST_FACTORY, "array<T>@ f(int&in type, int&in list) {repeat T}"
// =====================================================================================

/// @listpattern {repeat T}
class array<T>{
	T& opIndex(uint index);
	const T& opIndex(uint index) const;
	uint opForBegin() const;
	bool opForEnd(uint) const;
	uint opForNext(uint) const;
	const T& opForValue0(uint index) const;
	uint opForValue1(uint index) const;
	T[]& opAssign(const T[]&in);
	void insertAt(uint index, const T&in value);
	void insertAt(uint index, const T[]&inout arr);
	void insertLast(const T&in value);
	void removeAt(uint index);
	void removeLast();
	void removeRange(uint start, uint count);
	uint length() const;
	void reserve(uint length);
	void resize(uint length);
	void sortAsc();
	void sortAsc(uint startAt, uint count);
	void sortDesc();
	void sortDesc(uint startAt, uint count);
	void reverse();
	int find(const T&in value) const;
	int find(uint startAt, const T&in value) const;
	int findByRef(const T&in value) const;
	int findByRef(uint startAt, const T&in value) const;
	bool opEquals(const T[]&in) const;
	bool isEmpty() const;
	void sort(T[]::less&in, uint startAt = 0, uint count = uint(-1));
	funcdef bool less(const T&in, const T&in);
}


// =====================================================================================
// grid<T> - add_on/scriptgrid/scriptgrid.cpp    [not registered by AS-Harness]
//
// Its pattern is the interesting one:
//   asBEHAVE_LIST_FACTORY, "grid<T>@ f(int&in type, int&in list) {repeat {repeat_same T}}"
// A grid is a list of rows, and `repeat_same` requires every row to be the same length.
// =====================================================================================

/// @listpattern {repeat {repeat_same T}}
class grid<T>{
	T& opIndex(uint x, uint y);
	const T& opIndex(uint x, uint y) const;
	void resize(uint width, uint height);
	uint width() const;
	uint height() const;
}


// =====================================================================================
// dictionary - add_on/scriptdictionary/scriptdictionary.cpp
//
//   asBEHAVE_LIST_FACTORY, "dictionary @f(int &in) {repeat {string, ?}}"
// A dictionary is built from key/value pairs, which is why `dictionary d = {1, 2};` is rejected
// while `dictionary d = {{'a', 1}};` is not.
// =====================================================================================

class dictionaryValue{
	~dictionaryValue();
	dictionaryValue();
	dictionaryValue& opAssign(const dictionaryValue&in);
	dictionaryValue& opHndlAssign(const ?&in);
	dictionaryValue& opHndlAssign(const dictionaryValue&in);
	dictionaryValue& opAssign(const ?&in);
	dictionaryValue& opAssign(double);
	dictionaryValue& opAssign(int64);
	void opCast(?&out);
	void opConv(?&out);
	int64 opConv();
	double opConv();
}

/// @listpattern {repeat {string, ?}}
class dictionary{
	dictionary& opAssign(const dictionary&in);
	void set(const string&in, const ?&in);
	bool get(const string&in, ?&out) const;
	void set(const string&in, const int64&in);
	bool get(const string&in, int64&out) const;
	void set(const string&in, const double&in);
	bool get(const string&in, double&out) const;
	bool exists(const string&in) const;
	bool isEmpty() const;
	uint getSize() const;
	bool delete(const string&in);
	void deleteAll();
	string[]@ getKeys() const;
	dictionaryValue& opIndex(const string&in);
	const dictionaryValue& opIndex(const string&in) const;
	dictionaryIter@ opForBegin() const;
	bool opForEnd(dictionaryIter@) const;
	dictionaryIter@ opForNext(dictionaryIter@) const;
	const dictionaryValue& opForValue0(dictionaryIter@) const;
	const string& opForValue1(dictionaryIter@) const;
}

class dictionaryIter{
}


// =====================================================================================
// ref - add_on/scripthandle/scripthandle.cpp
//
// A generic handle to any reference type, for storing heterogeneous objects.
// =====================================================================================

class ref{
	~ref();
	ref();
	ref(const ref&in);
	ref(const ?&in);
	void opCast(?&out);
	ref& opHndlAssign(const ref&in);
	ref& opHndlAssign(const ?&in);
	bool opEquals(const ref&in) const;
	bool opEquals(const ?&in) const;
}


// =====================================================================================
// weakref<T> / const_weakref<T> - add_on/weakref/weakref.cpp    [not in AS-Harness]
//
// A handle that does not keep its target alive. `get()` returns null once the object is gone,
// which is the whole reason to reach for one.
// =====================================================================================

class weakref<T>{
	weakref();
	weakref(const weakref<T>&in);
	weakref(T@);
	/// Returns a strong handle to the target, or null if it has been destroyed.
	T@ get() const;
	T@ opImplCast();
	const T@ opImplCast() const;
	weakref<T>& opHndlAssign(const weakref<T>&in);
	weakref<T>& opHndlAssign(T@);
	bool opEquals(const weakref<T>&in) const;
	bool opEquals(const T@) const;
}

class const_weakref<T>{
	const_weakref();
	const_weakref(const const_weakref<T>&in);
	const_weakref(const T@);
	/// Returns a strong const handle to the target, or null if it has been destroyed.
	const T@ get() const;
	const T@ opImplCast() const;
	const_weakref<T>& opHndlAssign(const const_weakref<T>&in);
	const_weakref<T>& opHndlAssign(const T@);
	bool opEquals(const const_weakref<T>&in) const;
	bool opEquals(const T@) const;
}


// =====================================================================================
// any - add_on/scriptany/scriptany.cpp    [not registered by AS-Harness]
//
// A boxed value of any type. Unlike `ref` it holds value types too.
// =====================================================================================

class any{
	any();
	any(?&in);
	any(const int64&in);
	any(const double&in);
	any& opAssign(any&in);
	void store(?&in);
	void store(const int64&in);
	void store(const double&in);
	bool retrieve(?&out);
	bool retrieve(int64&out);
	bool retrieve(double&out);
}


