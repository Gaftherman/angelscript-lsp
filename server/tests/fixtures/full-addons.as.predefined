// =====================================================================================
// complex - add_on/scriptmath/scriptmathcomplex.cpp    [not in AS-Harness]
//
//   asBEHAVE_LIST_FACTORY, "void f(const int &in) {float, float}"
// A fixed pair rather than a repeat, so `complex c = {1, 2, 3};` has one element too many.
// =====================================================================================

/// @listpattern {float, float}
class complex{
	complex();
	complex(const complex&in);
	complex(float r, float i = 0);
	float r;
	float i;
	complex& opAddAssign(const complex&in);
	complex& opSubAssign(const complex&in);
	complex& opMulAssign(const complex&in);
	complex& opDivAssign(const complex&in);
	bool opEquals(const complex&in) const;
	complex opAdd(const complex&in) const;
	complex opSub(const complex&in) const;
	complex opMul(const complex&in) const;
	complex opDiv(const complex&in) const;
	float abs() const;
	complex get_ri() const;
	void set_ri(const complex&in);
	complex get_ir() const;
	void set_ir(const complex&in);
}


// =====================================================================================
// Exception handling
//
// `try` / `catch` and `throw` are language features rather than registered API, but the message a
// handler reads comes from a registered function. AS-Harness registers the Exception object below;
// the SDK's scripthelper registers `throw` and `getExceptionInfo` instead. Both are declared so a
// script written against either compiles here.
// =====================================================================================

/// Addon: ASException
/// Exception object storing callstack, line number, message, and metadata.
class Exception{
	/// Exception error message string.
	string message;
	/// Function declaration where exception occurred.
	string func;
	/// Script section or file name where exception occurred.
	string sect;
	/// Call stack trace at the moment exception occurred.
	string stack;
	/// Script line number where exception occurred.
	int line;
	/// Additional contextual data dictionary attached to exception.
	dictionary data;
}

/// Addon: ASException
/// Raises a script exception with an optional metadata dictionary.
void SetException(const string&in exception, dictionary@ data = null);

/// Addon: ASException
/// Returns the current active exception object.
Exception@ GetException();

/// add_on/scripthelper/scripthelper.cpp - raises a script exception.
void throw(const string&in exception);

/// add_on/scripthelper/scripthelper.cpp - the message of the exception being handled.
string getExceptionInfo();


// =====================================================================================
// Co-routines - add_on/contextmgr/contextmgr.cpp    [not registered by AS-Harness]
//
// Co-operative multitasking driven by the host's context manager. A co-routine runs until it calls
// yield(); nothing is pre-empted.
// =====================================================================================

/// The signature a co-routine entry point must have.
funcdef void coroutine(dictionary@);

/// Starts a co-routine, passing it the given argument dictionary.
void createCoRoutine(coroutine@ func, dictionary@ args);

/// Hands control back to the context manager; execution resumes on the next pass.
void yield();

/// Suspends this script for the given number of milliseconds.
void sleep(uint milliseconds);


// =====================================================================================
// socket    [NOT an SDK add-on - a host-specific example]
//
// There is no socket add-on in the AngelScript SDK. This section exists because a stub is how a
// host describes whatever it registered, and networking is a common thing to register. Treat the
// names as illustrative: match them to your own engine before relying on them.
// =====================================================================================

enum socket_family{
	AF_INET,
	AF_INET6
}

enum socket_type{
	SOCK_STREAM,
	SOCK_DGRAM
}

class socket{
	socket();
	socket(socket_family family, socket_type type);
	/// Binds the socket to a local address and port.
	bool bind(const string&in address, uint16 port);
	/// Marks the socket as accepting connections.
	bool listen(int backlog = 5);
	/// Accepts a pending connection, or null when none is waiting.
	socket@ accept();
	/// Connects to a remote endpoint.
	bool connect(const string&in address, uint16 port);
	/// Sends bytes; returns the number written, or a negative value on error.
	int send(const string&in data);
	/// Reads up to `length` bytes.
	string recv(uint length);
	/// Number of bytes readable without blocking.
	uint available() const;
	void close();
	/// Puts the socket into non-blocking mode.
	void setBlocking(bool blocking);
	bool isConnected() const;
	string getRemoteAddress() const;
	uint16 getRemotePort() const;
	string getLastError() const;
}


// =====================================================================================
// String utilities - add_on/scriptstdstring/scriptstdstring_utils.cpp
// =====================================================================================

uint scan(const string&in str, ?&out...);
string format(const string&in fmt, const ?&in...);
string formatInt(int64 val, const string&in options = "", uint width = 0);
string formatUInt(uint64 val, const string&in options = "", uint width = 0);
string formatFloat(double val, const string&in options = "", uint width = 0, uint precision = 0);
int64 parseInt(const string&in, uint base = 10, uint&out byteCount = 0);
uint64 parseUInt(const string&in, uint base = 10, uint&out byteCount = 0);
double parseFloat(const string&in, uint&out byteCount = 0);
string join(const string[]&in, const string&in);


// =====================================================================================
// System functions - add_on/scriptstdstring, add_on/scripthelper
// =====================================================================================

/// Prints a string to the console output.
void print(const string&in);

/// Prints a string to the console output followed by a newline.
void println(const string&in);


// =====================================================================================
// Math - add_on/scriptmath/scriptmath.cpp
//
// The add-on registers EITHER the float overloads or the double ones, depending on how the host
// compiled it (AS_USE_FLOAT). Both are declared so a script written against either resolves; the
// cost of the extra overloads is that this stub is more permissive than any one engine, which
// makes a missed diagnostic possible and a false one no more likely.
// =====================================================================================

float fpFromIEEE(uint);
uint fpToIEEE(float);
double fpFromIEEE(uint64);
uint64 fpToIEEE(double);
bool closeTo(float, float, float = 0.00001f);
bool closeTo(double, double, double = 0.0000000001);

float cos(float);
float sin(float);
float tan(float);
float acos(float);
float asin(float);
float atan(float);
float atan2(float, float);
float cosh(float);
float sinh(float);
float tanh(float);
float log(float);
float log10(float);
float pow(float, float);
float sqrt(float);
float ceil(float);
float abs(float);
float floor(float);
float fraction(float);

double cos(double);
double sin(double);
double tan(double);
double acos(double);
double asin(double);
double atan(double);
double atan2(double, double);
double cosh(double);
double sinh(double);
double tanh(double);
double log(double);
double log10(double);
double pow(double, double);
double sqrt(double);
double ceil(double);
double abs(double);
double floor(double);
double fraction(double);
