    {
      "name": "interface-and-implementation",
      "why": "Ensures interface types colour as interface and implementing classes colour as class.",
      "source": "interface Drivable\n{\n  void drive();\n}\n\nclass Car : Drivable\n{\n  void drive()\n  {\n  }\n}",
      "expect": [
        {
          "line": 0,
          "character": 10,
          "text": "Drivable",
          "type": "interface"
        },
        {
          "line": 2,
          "character": 7,
          "text": "drive",
          "type": "method"
