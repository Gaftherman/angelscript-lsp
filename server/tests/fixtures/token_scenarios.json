        {
          "line": 5,
          "character": 6,
          "text": "Car",
          "type": "class"
        },
        {
          "line": 5,
          "character": 12,
          "text": "Drivable",
          "type": "interface"
        },
        {
          "line": 7,
          "character": 7,
          "text": "drive",
          "type": "method"
        }
      ]
