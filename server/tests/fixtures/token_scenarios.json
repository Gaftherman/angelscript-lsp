    },
    {
      "name": "local-variable",
      "why": "Ensures local variables are tokenized as variable at definition and subsequent use sites.",
      "source": "void calculate()\n{\n  int total = 10;\n  int step = 2;\n  total = total + step;\n}",
      "expect": [
        {
          "line": 2,
          "character": 6,
          "text": "total",
          "type": "variable"
        },
        {
          "line": 3,
          "character": 6,
          "text": "step",
          "type": "variable"
        },
        {
          "line": 4,
          "character": 2,
          "text": "total",
          "type": "variable"
        },
        {
          "line": 4,
          "character": 10,
          "text": "total",
          "type": "variable"
        },
        {
          "line": 4,
          "character": 18,
          "text": "step",
          "type": "variable"
        }
      ]
    },
