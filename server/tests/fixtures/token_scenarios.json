    {
      "name": "literals-and-comments",
      "why": "Ensures numbers, boolean keywords, and standalone comments are tokenized as number, keyword, and comment.",
      "source": "// A standalone comment\nvoid test()\n{\n  int count = 42;\n  float speed = 3.14;\n  bool flag = true;\n  bool active = false;\n}",
      "expect": [
        {
          "line": 0,
          "character": 0,
          "text": "// A standalone comment",
          "type": "comment"
        },
        {
          "line": 3,
          "character": 14,
          "text": "42",
          "type": "number"
        },
        {
          "line": 4,
          "character": 16,
          "text": "3.14",
          "type": "number"
        },
        {
          "line": 5,
          "character": 14,
          "text": "true",
          "type": "keyword"
        },
        {
          "line": 6,
          "character": 16,
          "text": "false",
          "type": "keyword"
        }
      ]
    },
    {
      "name": "control-flow-keywords",
      "why": "Ensures control-flow statements if, while, and return are tokenized as keyword.",
      "source": "int loop(int n)\n{\n  while (n > 0)\n  {\n    if (n == 1)\n    {\n      return n;\n    }\n    else\n    {\n      return 0;\n    }\n  }\n  return 0;\n}",
      "expect": [
        {
          "line": 2,
          "character": 2,
          "text": "while",
          "type": "keyword"
        },
        {
          "line": 4,
          "character": 4,
          "text": "if",
          "type": "keyword"
        },
        {
          "line": 6,
          "character": 6,
          "text": "return",
          "type": "keyword"
        },
        {
          "line": 8,
          "character": 4,
          "text": "else",
          "type": "keyword"
        },
        {
          "line": 10,
          "character": 6,
          "text": "return",
          "type": "keyword"
        },
        {
          "line": 13,
          "character": 2,
          "text": "return",
          "type": "keyword"
        }
      ]
    },
    {
