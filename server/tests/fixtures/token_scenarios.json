{
  "scenarios": [
    {
      "name": "class-declaration",
      "why": "Ensures class names at the point of declaration are tokenized as class.",
      "source": "class Player\n{\n}\n\nclass Enemy\n{\n}\n\nclass Weapon\n{\n}\n\nclass Shield\n{\n}",
      "expect": [
        {
          "line": 0,
          "character": 6,
          "text": "Player",
          "type": "class"
        },
        {
          "line": 4,
          "character": 6,
          "text": "Enemy",
          "type": "class"
        },
        {
          "line": 8,
          "character": 6,
          "text": "Weapon",
          "type": "class"
        },
        {
          "line": 12,
          "character": 6,
          "text": "Shield",
          "type": "class"
        }
      ]
    },
    {
      "name": "class-member-property",
      "why": "Ensures class member variables are tokenized as property both at declaration and when accessed within methods.",
      "source": "class Player\n{\n  int health;\n  int maxHealth;\n\n  int getHealth()\n  {\n    return health;\n  }\n\n  int getMaxHealth()\n  {\n    return maxHealth;\n  }\n}",
      "expect": [
        {
          "line": 0,
          "character": 6,
          "text": "Player",
          "type": "class"
        },
        {
          "line": 2,
          "character": 6,
          "text": "health",
          "type": "property"
        },
        {
          "line": 3,
          "character": 6,
          "text": "maxHealth",
          "type": "property"
        },
        {
          "line": 7,
          "character": 11,
          "text": "health",
          "type": "property"
        },
        {
          "line": 12,
          "character": 11,
          "text": "maxHealth",
          "type": "property"
        }
      ]
    },
    {
      "name": "class-method-call",
      "why": "Ensures methods declared inside classes and their call sites are tokenized as method.",
      "source": "class Worker\n{\n  void execute() {}\n\n  void start()\n  {\n    execute();\n  }\n}\n\nvoid run()\n{\n  Worker w;\n  w.execute();\n}",
      "expect": [
        {
          "line": 0,
          "character": 6,
          "text": "Worker",
          "type": "class"
        },
        {
          "line": 2,
          "character": 7,
          "text": "execute",
          "type": "method"
        },
        {
          "line": 4,
          "character": 7,
          "text": "start",
          "type": "method"
        },
        {
          "line": 6,
          "character": 4,
          "text": "execute",
          "type": "method"
        },
        {
          "line": 13,
          "character": 4,
          "text": "execute",
          "type": "method"
        }
      ]
    },
    {
      "name": "free-function-call",
      "why": "Ensures free functions are tokenized as function at declaration and at call sites from other functions.",
      "source": "void helper()\n{\n}\n\nvoid compute()\n{\n  helper();\n}\n\nvoid caller()\n{\n  helper();\n  compute();\n}",
      "expect": [
        {
          "line": 0,
          "character": 5,
          "text": "helper",
          "type": "function"
        },
        {
          "line": 4,
          "character": 5,
          "text": "compute",
          "type": "function"
        },
        {
          "line": 6,
          "character": 2,
          "text": "helper",
          "type": "function"
        },
        {
          "line": 9,
          "character": 5,
          "text": "caller",
          "type": "function"
        },
        {
          "line": 11,
          "character": 2,
          "text": "helper",
          "type": "function"
        },
        {
          "line": 12,
          "character": 2,
          "text": "compute",
          "type": "function"
        }
      ]
    },
    {
      "name": "function-parameter",
