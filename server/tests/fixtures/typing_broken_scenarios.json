    {
      "name": "host-type-while-typing",
      "why": "Ensures half-typed host type names report unresolved type errors until fully spelled out.",
      "predefined": "class CBaseEntity\n{\n    void Spawn();\n    int get_Health() const property;\n    void set_Health(int v) property;\n}\nclass CBasePlayer : CBaseEntity\n{\n    void Kill();\n}\nfuncdef void ThinkFunc();\nint g_Gravity;",
      "initial": "void main()\n{\n    \n}",
      "steps": [
        {
          "type": "CBase ent;",
          "line": 2,
          "character": 4,
          "expectPresent": [
            "as-err-unresolved-type"
          ],
          "expectAbsent": [
            "as-syntax-error"
          ],
          "message": "Unknown type 'CBase'."
        },
        {
          "type": "Entity",
          "line": 2,
          "character": 9,
          "expectPresent": [],
          "expectAbsent": [
            "as-err-unresolved-type",
            "as-syntax-error"
          ]
        }
      ]
    },
