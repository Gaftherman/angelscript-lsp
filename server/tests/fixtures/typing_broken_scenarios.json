{
  "scenarios": [
    {
      "name": "var-decl-progressive",
      "why": "Catches syntax errors while typing variable type, identifier, and initializer progressively.",
      "initial": "void main()\n{\n    \n}",
      "steps": [
        {
          "type": "int ",
          "line": 2,
          "character": 4,
          "expectPresent": [
            "as-syntax-error"
          ],
          "expectAbsent": [],
          "message": "Syntax error"
        },
        {
          "type": "val ",
          "line": 2,
          "character": 8,
          "expectPresent": [
            "as-syntax-error"
          ],
          "expectAbsent": []
        },
        {
          "type": "= 1;",
          "line": 2,
          "character": 12,
          "expectPresent": [],
          "expectAbsent": [
            "as-syntax-error"
          ]
        }
      ]
    },
    {
